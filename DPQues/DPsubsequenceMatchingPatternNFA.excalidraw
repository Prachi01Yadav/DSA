      "containerId": null,
      "originalText": "KEY INSIGHT (why NFA not DFA):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "key1",
      "type": "text",
      "x": 40,
      "y": 690,
      "width": 655.6795043945312,
      "height": 20,
      "angle": 0,
      "strokeColor": "#ef4444",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aX",
      "roundness": null,
      "seed": 1780308746,
      "version": 2,
      "versionNonce": 8277130,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773307369738,
      "link": null,
      "locked": false,
      "text": "DFA: can only be in ONE state at a time  ->  misses multiple paths  ->  wrong count",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DFA: can only be in ONE state at a time  ->  misses multiple paths  ->  wrong count",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "key2",
      "type": "text",
      "x": 40,
      "y": 718,
      "width": 785.6953735351562,
      "height": 20,
      "angle": 0,
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aY",
      "roundness": null,
      "seed": 1430336150,
      "version": 2,
      "versionNonce": 113383702,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773307369738,
      "link": null,
      "locked": false,
      "text": "NFA: can be in MULTIPLE states simultaneously  ->  dp[state] counts ALL paths  ->  correct count",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NFA: can be in MULTIPLE states simultaneously  ->  dp[state] counts ALL paths  ->  correct count",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "key3",
      "type": "text",
      "x": 40,
      "y": 748,
      "width": 753.807373046875,
      "height": 20,
      "angle": 0,
      "strokeColor": "#8b5cf6",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
